<!--robot name="AGV_v6"-->
<robot name="AGV_v6">


  <link name="base_footprint"/>
  <!--base_footprint-->
  
  <link name="base_link"/>
  


  <!-- ================= IMU ================= -->
  <link name="imu_link"/>

  <!-- [변경] rpy "0 0 3.14159" → "0 0 0"
       base_link가 0° 회전되었으므로 IMU도 동일하게 0°로 맞춤
       (합산 회전: 0+0=0 → base_footprint 기준 정방향 정렬 유지) -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>


  <!-- [변경] rpy "0 0 3.14159" → "0 0 0"
       기존 180° 회전이 base_link +x를 base_footprint -x(후방)로 만들었음
       0°로 변경하면 base_link +x = base_footprint +x = 전방(forward) 정렬
       → lidar_lF(+x 방향)가 navigation 기준 전방에 위치하게 됨 -->
  <joint name="base_joint" type="fixed">
    <!--base_footprint joint base_link-->
    <origin rpy="0 0 0" xyz="0.0 0.0 0.075"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  
  
  
  <joint name="AGV_body_joint" type="fixed">
    <!--base_footpirnt joint base_link-->
    <origin rpy="0 0 0" xyz="0.0 0.0 0.1575"/>
    <parent link="base_link"/>
    <child link="AGV_body"/>
  </joint>

  <link name="AGV_body">
  <!--base_link-->
    <visual>
      <origin rpy="1.5708 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
      <!--box size="0.9 0.56 0.275"/-->
	<mesh filename="package://agv_body/cart_body.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>   
      <geometry>
      <box size="0.9 0.7 1.2"/>
      </geometry>
    </collision>
  </link>




  <!--lidar1 (Front) -->
  <!-- [유지] base_joint 0°로 변경 후 이 위치는 base_footprint 기준 우전방(+x,-y) → 전방 LiDAR 정상 위치 -->
  <joint name="lidar_jF" type="fixed">
    <origin rpy="0 0 2.35619" xyz="0.41 -0.24 0.140"/>
    <parent link="base_link"/>
    <child link="lidar_lF"/><!--lidar_link-->
  </joint>
  
  
  <link name="lidar_lF">
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.04"/>
      </geometry>
    </collision>
  </link>
  
  
  
  
  
  
  <!--lidar2 (Rear) -->
  <!-- [유지] base_joint 0°로 변경 후 이 위치는 base_footprint 기준 좌후방(-x,+y) → 후방 LiDAR 정상 위치 -->
  <joint name="lidar_jR" type="fixed">
    <origin rpy="0 0 -0.78539" xyz="-0.41 0.24 0.140"/> 
    <parent link="base_link"/>
    <child link="lidar_lR"/><!--lidar_link-->
  </joint>
  
  <link name="lidar_lR">
    <collision>
      <geometry>
        <!--cylinder length="" radius=""/-->
        <cylinder length="0.02" radius="0.04"/>
      </geometry>
    </collision>
  </link>
  
  
  
  

  <joint name="lidar_jMer" type="fixed">
    <origin rpy="0 0 0.0" xyz="0.0 0.0 0.171"/>
    <parent link="base_link"/>
    <child link="lidar_lMer"/><!--lidar_link-->
  </joint>
  
  <link name="lidar_lMer">
  </link>




  <!-- [유지] 물리적 위치는 base_link 기준으로 동일 -->
  <!-- base_joint 0°이면 motor_lLe → base_footprint +y = 좌측(Left) 정상 -->
 <joint name="motor_jLe" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.24 0"/>
    <parent link="base_link"/>
    <child link="motor_lLe"/>
  </joint>
  
  <link name="motor_lLe">
  </link>
  
  
  <!-- base_joint 0°이면 motor_lRi → base_footprint -y = 우측(Right) 정상 -->
  <joint name="motor_jRi" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.24 0"/>
    <parent link="base_link"/>
    <child link="motor_lRi"/>
  </joint>
  
  <link name="motor_lRi">
  </link>

</robot>
