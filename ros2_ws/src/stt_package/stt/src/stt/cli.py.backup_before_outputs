import argparse
from pathlib import Path

from stt.config import STTConfig
from stt.postprocess import postprocess_stt_text
from stt.recorder import RecordConfig, record_enter_to_start_stop
from stt.transcriber import run_whisper_server
from stt.writer import save_text


LINE = "=" * 60


def main():
    parser = argparse.ArgumentParser(
        prog="stt",
        description="Microphone STT package using whisper.cpp server"
    )

    parser.add_argument(
        "--server-url",
        default="http://127.0.0.1:8080/inference",
        help="whisper-server 요청 주소"
    )

    parser.add_argument(
        "--output-dir",
        default="/mnt/ssd/cart_ros2/src/bus/stt_input",
        help="변환된 txt 파일 저장 폴더"
    )

    parser.add_argument(
        "--lang",
        default="ko",
        help="인식 언어"
    )

    parser.add_argument(
        "--device",
        default=None,
        help="ALSA 녹음 장치. 예: plughw:3,0"
    )

    args = parser.parse_args()

    config = STTConfig(
        output_dir=Path(args.output_dir),
        language=args.lang,
        server_url=args.server_url,
    )

    rcfg = RecordConfig(
        sample_rate=config.sample_rate,
        channels=1,
        audio_format="S16_LE",
        device=args.device,
        output_dir="/tmp",
    )

    while True:
        print()
        print(LINE)
        print()

        audio_path = record_enter_to_start_stop(rcfg)

        text = run_whisper_server(
            server_url=config.server_url,
            audio=audio_path,
            sample_rate=config.sample_rate,
            language=config.language,
        ).replace("[끝]", "").strip()

        corrected_text = postprocess_stt_text(text)

        txt_path = save_text(
            text=corrected_text,
            out_dir=config.output_dir,
        )

        print()
        print(f"원본 인식: {text}")
        print(f"후처리 결과: {corrected_text}")
        print(f"텍스트 파일 생성: {txt_path}")
        print()
        print(LINE)
        print()


if __name__ == "__main__":
    main()
